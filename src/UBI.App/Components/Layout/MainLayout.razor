@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div>
                <p class="top-row__eyebrow">Managed UBI System</p>
                <div class="top-row__title">Solid GUI foundation for estate transparency, presence, and leadership oversight</div>
            </div>

            <div class="top-row__status">
                <span class="status-pill">Phase 1 foundation</span>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
